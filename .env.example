# Salin berkas ini menjadi .env lalu sesuaikan.
# Kalau variabel yang sama sudah diatur di docker-compose.yml / CasaOS,
# nilai dari environment container yang dipakai lebih dulu.

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASS=ubah_kata_sandi_ini

APP_NAME=E-Commerce Analytics
APP_TZ=Asia/Jakarta

# Simpan salinan berkas yang diunggah di storage/uploads (1 = ya, 0 = tidak)
KEEP_UPLOADED_FILES=1

# Simpan salinan baris asli dalam bentuk JSON untuk keperluan audit (1 = ya)
# Matikan (0) bila ruang disk terbatas.
KEEP_RAW_JSON=1

# Jumlah baris per batch saat import
IMPORT_BATCH_SIZE=400
